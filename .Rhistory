'Depth_m',
'Temp_C',
'DiveID')
profile_df <- profile_df %>%
filter(!is.na(Depth_m)) %>%
filter(!is.na(Temp_C)) %>%
mutate(
Depth_bin_m = floor(Depth_m / DEPTH_BIN_M) * DEPTH_BIN_M
)
DEPTH_BIN_M
## Per-dive temperature-depth profile (only within actual dives, DiveID > 0)
temp_depth_by_dive <- profile_df %>%
filter(DiveID > 0) %>%
group_by(DiveID, Depth_bin_m) %>%
summarise(
n_obs        = n(),
mean_temp_C  = mean(Temp_C),
sd_temp_C    = sd(Temp_C),
min_temp_C   = min(Temp_C),
max_temp_C   = max(Temp_C),
.groups = "drop"
) %>%
arrange(DiveID, Depth_bin_m)
## Per-dive temperature-depth profile (only within actual dives, DiveID > 0)
temp_depth_by_dive <- profile_df %>%
filter(DiveID > 0) %>%
group_by(DiveID, Depth_bin_m) %>%
summarise(
n_obs        = n(),
mean_temp_C  = mean(Temp_C, na.rm=T),
sd_temp_C    = sd(Temp_C, na.rm=T),
min_temp_C   = min(Temp_C, na.rm=T),
max_temp_C   = max(Temp_C, na.rm=T),
.groups = "drop"
) %>%
arrange(DiveID, Depth_bin_m)
