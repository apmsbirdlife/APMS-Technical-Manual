INPUT_FILE  <- "C:/Users/Vulpe/Desktop/A3_S1.csv"          # path to raw AxyTrek export
OUTPUT_DIR  <- "axytrek_output"       # all results are written here
getwd()
OUTPUT_DIR  <- "C:/Users/Vulpe/Documents/Code/Dive/"       # all results are written here
TAG_TZ      <- "UTC"                  # timezone the logger's clock was set to
ACC_HZ      <- 50                     # accelerometer sampling rate (Hz)
FIX_HZ      <- 1                      # depth/temperature/GPS sampling rate (Hz)
## Dive-detection / zero-offset-correction (ZOC) parameters -- diveMove::calibrateDepth()
DIVE_THRESHOLD_M <- 2      # depth (m) below which a submersion counts as a "dive"
ZOC_METHOD        <- "offset"  # "offset" (simple, needs ZOC_OFFSET_M), "filter", or "visual"
ZOC_OFFSET_M      <- 0     # known surface offset in m (0 = trust the recorded depth)
DRY_THR_S         <- 70    # dry spells shorter than this (s) are treated as wet
WET_THR_S         <- 30    # wet spells shorter than this (s) are treated as trivial
## Dive-phase model used internally by calibrateDepth() to split each dive
## into descent/bottom/ascent. diveMove's own default is "unimodal", but that
## requires the optional 'uniReg' package (which has occasionally been pulled
## from CRAN). "smooth.spline" only needs base R and works everywhere, so it
## is used as the default here -- switch to "unimodal" if you have uniReg
## installed and want diveMove's preferred phase-detection method.
DIVE_MODEL  <- "smooth.spline"
SMOOTH_PAR  <- 0.1
## Temperature-depth profiling
DEPTH_BIN_M <- 1           # bin width for the temperature-at-depth profile, in m
read_axytrek <- function(path, tz = "UTC") {
col_names <- c(
"TagID", "DateTime", "AccX_g", "AccY_g", "AccZ_g", "Status",
"Depth_m", "Temp_C",
"GPS_Lat", "GPS_Lon",
"GPS_field1", "GPS_field2", "GPS_field3", "GPS_field4", "GPS_field5",
"Flag"
)
raw_lines <- readLines(path, warn = FALSE)
## Case A: plain tab-delimited text (the native AxyTrek format)
looks_tab_delimited <- grepl("\t", raw_lines[1]) && !grepl('^""', raw_lines[1])
if (!looks_tab_delimited) {
## Case B: a CSV-quoted export, e.g. `"1","A8_S2\t2026/06/09 ...\t0999"`
## Drop a header row if present (e.g. the two-column `"","x"` R default).
if (!grepl("\t", raw_lines[1])) raw_lines <- raw_lines[-1]
## Strip a leading `"<row number>",` if present
raw_lines <- sub('^"[0-9]+",', "", raw_lines)
## Strip the surrounding quotes left on the actual data field
raw_lines <- gsub('^"|"$', "", raw_lines)
}
split_rows <- strsplit(raw_lines, "\t", fixed = TRUE)
n_cols <- length(col_names)
## Pad/truncate ragged rows defensively so rbind never fails
split_rows <- lapply(split_rows, function(r) {
length(r) <- n_cols
r
})
df <- as.data.frame(do.call(rbind, split_rows), stringsAsFactors = FALSE)
names(df) <- col_names
df <- df %>%
mutate(
DateTime = as.POSIXct(DateTime, format = "%Y/%m/%d %H:%M:%OS", tz = tz),
AccX_g   = as.numeric(AccX_g),
AccY_g   = as.numeric(AccY_g),
AccZ_g   = as.numeric(AccZ_g),
Depth_m  = as.numeric(Depth_m),
Temp_C   = as.numeric(Temp_C),
GPS_Lat  = as.numeric(GPS_Lat),
GPS_Lon  = as.numeric(GPS_Lon)
)
df
}
message("Reading raw AxyTrek file: ", INPUT_FILE)
axy_raw <- read_axytrek(INPUT_FILE, tz = TAG_TZ)
message("  -> ", nrow(axy_raw), " accelerometer rows read (",
round(nrow(axy_raw) / ACC_HZ, 1), " s of data at ", ACC_HZ, " Hz)")
## Collapse to the 1-Hz depth/temperature/GPS channel: keep only the rows
## where Depth_m was actually recorded (the rest are accelerometer-only rows).
tdr_df <- axy_raw %>%
filter(!is.na(Depth_m)) %>%
select(DateTime, Depth_m, Temp_C, GPS_Lat, GPS_Lon) %>%
arrange(DateTime) %>%
distinct(DateTime, .keep_all = TRUE)   # diveMove requires strictly increasing time
message("  -> ", nrow(tdr_df), " depth/temperature records at ~", FIX_HZ, " Hz")
if (nrow(tdr_df) < 10) {
stop("Fewer than 10 depth records were found -- check INPUT_FILE, ACC_HZ, ",
"and FIX_HZ before continuing.")
}
View(tdr_df)
View(axy_raw)
