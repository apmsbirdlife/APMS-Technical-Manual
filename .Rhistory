read_axytrek <- function(path, tz = "UTC") {
header_line <- readLines(path, n = 1, warn = FALSE, encoding = "UTF-8")
## Detect the field delimiter as whichever candidate appears most often
## in the header row.
candidates <- c("\t", ";", ",")
counts <- vapply(candidates, function(d) {
lengths(regmatches(header_line, gregexpr(d, header_line, fixed = TRUE)))
}, numeric(1))
delim <- candidates[which.max(counts)]
message("  Detected field delimiter: ", ifelse(delim == "\t", "<tab>", delim))
df <- read.table(
path, header = TRUE, sep = delim, quote = "\"",
na.strings = c("", "NA"), stringsAsFactors = FALSE,
fileEncoding = "UTF-8", comment.char = "", check.names = FALSE
)
## Standard column names, assigned by position (the AxyTrek field order is
## fixed even though header text/encoding varies). If your export has a
## different number/order of columns, edit this vector to match.
std_names <- c(
"TagID", "DateTime", "AccX_g", "AccY_g", "AccZ_g", "Status",
"Depth_m", "Temp_C",
"GPS_Lat", "GPS_Lon", "Altitude_m", "GroundSpeed_kmh",
"Satellites", "HDOP", "SignalStrength",
"SensorRaw", "Battery_V"
)
if (ncol(df) != length(std_names)) {
warning(
"Expected ", length(std_names), " columns in the AxyTrek export but ",
"found ", ncol(df), " (original header: ", paste(names(df), collapse = " | "),
"). Column names below were assigned by position and may be wrong -- ",
"inspect the data and adjust `std_names` in read_axytrek() if needed."
)
}
names(df)[seq_len(min(ncol(df), length(std_names)))] <-
std_names[seq_len(min(ncol(df), length(std_names)))]
df <- df %>%
mutate(
DateTime = as.POSIXct(DateTime, format = "%Y/%m/%d %H:%M:%OS", tz = tz),
across(
any_of(c("AccX_g", "AccY_g", "AccZ_g", "Depth_m", "Temp_C",
"GPS_Lat", "GPS_Lon", "Altitude_m", "GroundSpeed_kmh",
"Satellites", "HDOP", "SignalStrength", "SensorRaw", "Battery_V")),
as.numeric
)
)
df
}
message("Reading raw AxyTrek file: ", INPUT_FILE)
axy_raw <- read_axytrek(INPUT_FILE, tz = TAG_TZ)
message("  -> ", nrow(axy_raw), " accelerometer rows read (",
round(nrow(axy_raw) / ACC_HZ, 1), " s of data at ", ACC_HZ, " Hz)")
## Collapse to the 1-Hz depth/temperature/GPS channel: keep only the rows
## where Depth_m was actually recorded (the rest are accelerometer-only rows).
tdr_df <- axy_raw %>%
filter(!is.na(Depth_m)) %>%
select(DateTime, Depth_m, Temp_C, GPS_Lat, GPS_Lon) %>%
arrange(DateTime) %>%
distinct(DateTime, .keep_all = TRUE)   # diveMove requires strictly increasing time
message("  -> ", nrow(tdr_df), " depth/temperature records at ~", FIX_HZ, " Hz")
if (nrow(tdr_df) < 10) {
stop("Fewer than 10 depth records were found -- check INPUT_FILE, ACC_HZ, ",
"and FIX_HZ before continuing.")
}
dir.create(OUTPUT_DIR, showWarnings = FALSE, recursive = TRUE)
OUTPUT_DIR
write_csv(tdr_df, file.path(OUTPUT_DIR, "01_depth_temp_1Hz.csv"))
tdrX <- createTDR(
time            = tdr_df$DateTime,
depth           = tdr_df$Depth_m,
concurrentData  = data.frame(temperature = tdr_df$Temp_C),
dtime           = 1 / FIX_HZ,
file            = basename(INPUT_FILE)
)
dcalib <- calibrateDepth(
tdrX,
dry.thr    = DRY_THR_S,
wet.thr    = WET_THR_S,
dive.thr   = DIVE_THRESHOLD_M,
zoc.method = ZOC_METHOD,
offset     = ZOC_OFFSET_M,
dive.model = DIVE_MODEL,
smooth.par = SMOOTH_PAR
)
print(dcalib)
n_dives <- max(getDAct(dcalib, "dive.id"), 0)
message("Detected ", n_dives, " dive(s).")
if (n_dives == 0) {
warning(
"No dives were detected with the current settings (DIVE_THRESHOLD_M = ",
DIVE_THRESHOLD_M, " m). This is expected for the bundled example file, ",
"which only contains ~1.5 minutes of dry, on-deck data. When you point ",
"this script at a real deployment file, lower DIVE_THRESHOLD_M if your ",
"animal makes shallow dives, or inspect 01_depth_temp_1Hz.csv to confirm ",
"the depth channel parsed correctly."
)
}
if (n_dives > 0) {
dive_stats <- diveStats(dcalib)
dive_stamps <- stampDive(dcalib, ignoreZ = TRUE)
dive_stats <- bind_cols(dive_stamps, dive_stats)
write_csv(dive_stats, file.path(OUTPUT_DIR, "02_dive_statistics.csv"))
message("Wrote per-dive statistics to 02_dive_statistics.csv")
} else {
dive_stats <- NULL
}
tdr_cal   <- getTDR(dcalib)                      # calibrated TDR object
depth_zoc <- getDepth(tdr_cal)                   # zero-offset-corrected depth
temp_vals <- getCCData(tdr_cal, "temperature")
time_vals <- getTime(tdr_cal)
dive_id   <- getDAct(dcalib, "dive.id")          # 0 = not part of a dive
profile_df <- data.frame(
DateTime = time_vals,
Depth_m  = depth_zoc,
Temp_C   = temp_vals,
DiveID   = dive_id
) %>%
filter(!is.na(Depth_m), !is.na(Temp_C)) %>%
mutate(
Depth_bin_m = floor(Depth_m / DEPTH_BIN_M) * DEPTH_BIN_M
)
temp_vals
depth_zoc
